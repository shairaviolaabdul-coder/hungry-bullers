# Copy this file to .env.local and fill in real values from your Supabase
# project settings (Project Settings -> API). Never commit .env.local.

# Public — safe to expose in the browser bundle. Access is governed entirely
# by Row Level Security policies and the submit_order() database function,
# not by keeping this value secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Do NOT add a service_role key here. This project has no server-side use
# for it — order creation goes through the SECURITY DEFINER submit_order()
# function, which is safe to call with the anon key. If a future admin
# dashboard needs the service role key, keep it server-only (never
# NEXT_PUBLIC_-prefixed) and load it exclusively in trusted server code.
